# WorkBuddy QQ Agent Gateway environment configuration template
# Copy to config/qq-only.env (never commit real IDs or secrets).
# Secrets such as hub-api-token, onebot-api-token, and home-assistant-api-token
# are stored in macOS Keychain under service "WorkBuddy QQ Gateway".

WORKBUDDY_QQ_OWNER_QQ_ID=100000001
WORKBUDDY_QQ_BOT_QQ_ID=100000002
WORKBUDDY_QQ_HOST=127.0.0.1
WORKBUDDY_QQ_PORT=3789
WORKBUDDY_QQ_DISABLE_AUTH=0
ONEBOT_API_BASE=http://127.0.0.1:3000

# Optional engine / runtime overrides
WORKBUDDY_QQ_WB_MODEL=auto
WORKBUDDY_QQ_REASONING_EFFORT=low

# Optional Home Assistant integration
WORKBUDDY_QQ_HA_ENABLED=0
WORKBUDDY_QQ_HA_BASE_URL=
# Leave blank to use the first available supported speaker for scheduled greetings.
WORKBUDDY_QQ_HA_GREETING_SPEAKER=
WORKBUDDY_QQ_SPEAKER_WEATHER_LOCATION=
