# Copy this file to config/qq-only.env and replace the placeholders.
# The real file is ignored by Git.

CODEX_REMOTE_CONTACT_HOST=127.0.0.1
CODEX_REMOTE_CONTACT_PORT=3789
# Optional convenience mode for a loopback-only Hub. With 1, the local Codex
# panel does not ask for a Hub token. Keep 0 if the Hub is ever exposed beyond
# this Mac; the OneBot callback token remains required either way.
CODEX_REMOTE_CONTACT_DISABLE_AUTH=0
# REQUIRED: your administrator account and a separate bot account. No defaults.
CODEX_REMOTE_CONTACT_OWNER_QQ_ID=
CODEX_REMOTE_CONTACT_BOT_QQ_ID=
CODEX_REMOTE_CONTACT_ENGINE=workbuddy
# Optional private personality override, relative to the project or absolute.
# Copy both persona/core.json and persona/examples.json into this ignored folder
# before enabling it. Invalid or missing files cause startup to stop.
# CODEX_REMOTE_CONTACT_PERSONA_DIR=config/private/persona
# The launcher reads the tokens from the macOS Keychain by default. Do not put
# real tokens in this file. These variables are only for temporary overrides.
# CODEX_REMOTE_CONTACT_API_TOKEN=temporary-override-only
# ONEBOT_ACCESS_TOKEN=temporary-override-only

ONEBOT_API_BASE=http://127.0.0.1:3000
CODEX_CLI_PATH=/Applications/ChatGPT.app/Contents/Resources/codex

# Isolated SnowLuma runtime installed by the local setup.
CODEX_REMOTE_CONTACT_COLIMA_PROFILE=snowluma
CODEX_REMOTE_CONTACT_DOCKER_CONTEXT=colima-snowluma
CODEX_REMOTE_CONTACT_SNOWLUMA_CONTAINER=snowluma
CODEX_REMOTE_CONTACT_DOCKER_PATH=/opt/homebrew/bin/docker
CODEX_REMOTE_CONTACT_KEYCHAIN_SERVICE=Codex Remote Contact QQ
# Optional Home Assistant MCP tools, scoped by each conversation's permission.
# Save a dedicated API token as account home-assistant-api-token under the
# Keychain service above; the runner loads it only into the Node gateway.
CODEX_REMOTE_CONTACT_HA_ENABLED=0
# CODEX_REMOTE_CONTACT_HA_BASE_URL=http://homeassistant.local:8123
# Buttons may execute arbitrary device actions: explicitly allow safe IR/media IDs.
# CODEX_REMOTE_CONTACT_HA_ALLOWED_BUTTONS=button.your_ir_ac_on,button.your_ir_ac_off
# Xiaomi playback-text notify entities only; never execute_text_directive.
# CODEX_REMOTE_CONTACT_HA_ALLOWED_SPEAKERS=notify.xiaomi_your_device_play_text_a_5_3

# QQ-only persistent group Agent gateway.
CODEX_REMOTE_CONTACT_QZONE_POST_SCHEDULE=08:00,12:00,18:00
CODEX_REMOTE_CONTACT_QQ_IMAGE_MAX_BYTES=20971520
CODEX_REMOTE_CONTACT_QQ_ATTACHMENT_MAX_BYTES=1073741824
CODEX_REMOTE_CONTACT_QQ_MEDIA_TTL_MS=604800000
CODEX_REMOTE_CONTACT_QQ_FILE_MAX_BYTES=1073741824
CODEX_REMOTE_CONTACT_QQ_IMAGE_SEND_MAX_BYTES=20971520
# Maximum number of labeled native QQ stickers exposed to each Agent turn.
CODEX_REMOTE_CONTACT_QQ_STICKER_PROMPT_LIMIT=24
# SnowLuma waits for QQ's complete chunked upload before replying. Keep this
# above the largest expected upload duration (default here: 6 hours).
CODEX_REMOTE_CONTACT_QQ_FILE_UPLOAD_TIMEOUT_MS=21600000
# Each Agent group gets one isolated subdirectory here. Non-OWNER turns can
# create and send files only inside their current group's subdirectory.
# CODEX_REMOTE_CONTACT_GROUP_WORKSPACE_ROOT=/absolute/path/to/group-workspaces
# Keep this inside the dedicated container-only prefix.
CODEX_REMOTE_CONTACT_QQ_FILE_STAGING_ROOT=/tmp/codexremotecontact-qq-files
# Upper bound for continuous silence. It is not a total turn-duration limit;
# Genuine bridge/model progress (reasoning, tools, web/file work, or text) restarts
# the 3-minute watchdog. Context compaction instead has an absolute 6-minute limit.
CODEX_REMOTE_CONTACT_QQ_AGENT_TIMEOUT_MS=600000
# Keep one persistent thread and ask Codex to compact it earlier. This only
# changes when history is summarized; it does not create a replacement thread.
CODEX_REMOTE_CONTACT_AUTO_COMPACT_TOKEN_LIMIT=200000
CODEX_REMOTE_CONTACT_AUTO_COMPACT_TOKEN_SCOPE=total

# Optional override if Node is not discoverable under launchd.
CODEX_REMOTE_CONTACT_NODE_PATH=/opt/homebrew/bin/node
